# Supabase project (Project Settings → Data API / API Keys)
# Use the publishable key only — never a service_role key in a client bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Vercel's Supabase integration sets VITE_SUPABASE_PUBLISHABLE_KEY instead — either works.
